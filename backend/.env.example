# Copy this file to .env and fill in your values. .env is ignored by git.

# TomTom API key (https://developer.tomtom.com/) - free tier is enough.
# Used for: live flow tiles on all roads, incidents (incl. French roadworks),
# corridor travel times and departure-time curves.
TOMTOM_API_KEY=

# Record live snapshots into data/recordings/traffic.sqlite while the app runs.
RECORD=true
# Also record TomTom corridor travel times (uses ~50 requests/hour while running).
RECORD_TOMTOM=true

# Browser origins allowed to call this API (comma-separated). "*" is fine on a home network.
CORS_ORIGINS=*
