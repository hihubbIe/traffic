# Copy this file to .env and fill in your values. .env is ignored by git.

# TomTom API key (https://developer.tomtom.com/).
TOMTOM_API_KEY=

# TomTom requests per day (map tiles not counted). Set it to your plan's free daily allowance.
TOMTOM_DAILY_BUDGET=2300
# Part of that budget the collector leaves for the app (live times, "when to leave").
TOMTOM_APP_RESERVE=300

# Run the collector inside the API process. true on a single PC; false when the collector
# runs as its own process (python -m app.collector), e.g. on an always-on machine.
COLLECT_IN_API=true

# Browser origins allowed to call this API (comma-separated). "*" is fine on a home network.
CORS_ORIGINS=*

# Optional: where data/ lives (default: backend/data) and where the built app is served from
# (default: ../frontend/dist; served at "/" when it exists).
# TRAFFIC_DATA_DIR=
# FRONTEND_DIST=
